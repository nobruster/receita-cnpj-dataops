# Copie para .env e ajuste. O .env NUNCA vai para o git.
# Gerar segredos (PowerShell):  [guid]::NewGuid().ToString("N")

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
# porta no Windows (5433 evita conflito com um Postgres local)
PG_PORT_HOST=5433
PG_DB=cnpj
PG_USER=cnpj
PG_PASSWORD=

# ---------------------------------------------------------------- Airflow
AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_JWT_SECRET=
AIRFLOW_FERNET_KEY=

# ---------------------------------------------------------------- Dados
# Volume nomeado (padrão, mais rápido) ou caminho do Windows, ex.: D:/cnpj-data
CNPJ_DATA=cnpj_data
# Recursos do DuckDB: ~50% da RAM dada ao Docker é um bom ponto de partida
DUCKDB_MEMORY_LIMIT=8GB
DUCKDB_THREADS=4

# ---------------------------------------------------------------- Fonte (Receita / SERPRO+)
RFB_WEBDAV_URL=https://arquivos.receitafederal.gov.br/public.php/webdav
RFB_SHARE_TOKEN=   # token do link publico da Receita (preencher no .env, nunca no git)
RFB_VERIFY_SSL=true
# RFB_CA_BUNDLE=/data/certs/ca-corporativa.pem   # proxy com inspeção TLS
# HTTPS_PROXY=http://proxy.empresa:8080
DOWNLOAD_WORKERS=3
# true = não baixa; processa zips colocados manualmente em /data/landing/AAAA-MM
OFFLINE_MODE=false

# ---------------------------------------------------------------- Qualidade
DQ_VOLUME_DROP_PCT=5
DQ_REJECT_RATE_PCT=0.5

# ---------------------------------------------------------------- Publicação no Postgres (Power BI)
PUBLISH_ENABLED=true
PUBLISH_TABLES=gold_resumo_competencia,gold_painel_prospeccao,gold_rede_societaria

# ---------------------------------------------------------------- Sentinel (CrewAI)
# openai | ollama | none
SENTINEL_LLM_PROVIDER=openai
OPENAI_API_KEY=
SENTINEL_LLM_MODEL=openai/gpt-5.6-luna
SENTINEL_MANAGER_MODEL=openai/gpt-5.6-terra
# Para Ollama: SENTINEL_LLM_PROVIDER=ollama, SENTINEL_LLM_MODEL=ollama/qwen2.5:14b,
#              SENTINEL_MANAGER_MODEL=ollama/qwen2.5:14b e suba com --profile ollama
OLLAMA_BASE_URL=http://ollama:11434
